{
  "name": "coreforge-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise Backend Infrastructure Platform",
  "workspaces": [
    "apps/playground",
    "packages/foundation/*",
    "packages/framework/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean && rimraf packages/foundation/*/dist packages/framework/*/dist apps/*/dist",
    "dev": "tsc -b -w",
    "lint": "eslint \"**/*.ts\" --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "test": "node --test packages/framework/runtime/dist/tests/runtime.test.js packages/framework/config/dist/tests/config.test.js packages/framework/cache/dist/tests/cache.test.js packages/framework/container/dist/tests/container.test.js packages/framework/events/dist/tests/events.test.js packages/framework/jobs/dist/tests/jobs.test.js packages/framework/locks/dist/tests/locks.test.js packages/framework/rate-limit/dist/tests/rateLimit.test.js packages/framework/resilience/dist/tests/resilience.test.js packages/framework/modules/dist/tests/modules.test.js packages/framework/logging/dist/tests/logging.test.js packages/framework/metrics/dist/tests/metrics.test.js packages/framework/tracing/dist/tests/tracing.test.js packages/framework/exceptions/dist/tests/exceptions.test.js packages/framework/bootstrap/dist/tests/bootstrap.test.js packages/framework/http/dist/tests/http.test.js packages/framework/router/dist/tests/router.test.js packages/framework/middleware/dist/tests/middleware.test.js packages/framework/controllers/dist/tests/controllers.test.js packages/framework/request-handler/dist/tests/request-handler.test.js packages/framework/binding/dist/tests/binding.test.js packages/framework/request-scope/dist/tests/request-scope.test.js packages/framework/action-invoker/dist/tests/action-invoker.test.js packages/framework/serialization/dist/tests/serialization.test.js packages/framework/security/dist/tests/security.test.js packages/framework/interceptors/dist/tests/interceptors.test.js packages/framework/application/dist/tests/application.test.js packages/framework/metadata/dist/tests/metadata.test.js packages/framework/decorators/dist/tests/decorators.test.js packages/framework/di/dist/tests/di.test.js packages/framework/request-context/dist/tests/request-context.test.js packages/framework/parameter-binding/dist/tests/parameter-binding.test.js packages/framework/routing/dist/tests/routing.test.js packages/framework/execution/dist/tests/execution.test.js packages/framework/response/dist/tests/response.test.js packages/framework/transport/dist/tests/transport.test.js packages/framework/discovery/dist/tests/discovery.test.js packages/framework/compiler/dist/tests/compiler.test.js packages/framework/scanner/dist/tests/scanner.test.js packages/framework/assembler/dist/tests/assembler.test.js packages/framework/runtime-initializer/dist/tests/runtime-initializer.test.js packages/framework/runtime-orchestrator/dist/tests/runtime-orchestrator.test.js packages/framework/extensions/dist/tests/extensions.test.js packages/framework/plugins/dist/tests/plugins.test.js packages/framework/kernel/dist/tests/kernel.test.js"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@types/node": "^20.11.24",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-unused-imports": "^3.1.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3"
  }
}
