{
  "name": "coreforge-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise Backend Infrastructure Platform",
  "workspaces": [
    "apps/playground",
    "packages/foundation/*",
    "packages/framework/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean && rimraf packages/foundation/*/dist packages/framework/*/dist apps/*/dist",
    "dev": "tsc -b -w",
    "lint": "eslint \"**/*.ts\" --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "test": "node --test packages/framework/runtime/dist/tests/runtime.test.js packages/framework/config/dist/tests/config.test.js packages/framework/container/dist/tests/container.test.js packages/framework/events/dist/tests/events.test.js packages/framework/modules/dist/tests/modules.test.js packages/framework/logging/dist/tests/logging.test.js packages/framework/exceptions/dist/tests/exceptions.test.js packages/framework/bootstrap/dist/tests/bootstrap.test.js packages/framework/http/dist/tests/http.test.js packages/framework/router/dist/tests/router.test.js packages/framework/middleware/dist/tests/middleware.test.js packages/framework/controllers/dist/tests/controllers.test.js packages/framework/request-handler/dist/tests/request-handler.test.js packages/framework/binding/dist/tests/binding.test.js packages/framework/request-scope/dist/tests/request-scope.test.js packages/framework/action-invoker/dist/tests/action-invoker.test.js packages/framework/serialization/dist/tests/serialization.test.js packages/framework/security/dist/tests/security.test.js packages/framework/interceptors/dist/tests/interceptors.test.js packages/framework/application/dist/tests/application.test.js"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@types/node": "^20.11.24",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-unused-imports": "^3.1.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3"
  }
}
