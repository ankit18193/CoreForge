      "@coreforge/parameter-binding": ["packages/framework/parameter-binding/src/index.ts"],
      "@coreforge/routing": ["packages/framework/routing/src/index.ts"],
      "@coreforge/execution": ["packages/framework/execution/src/index.ts"],
